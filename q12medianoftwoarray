/*Sample Input 
3 4 
1 3 8 
2 7 10 11 
Sample Output 7.0 
Explanation: The combined sorted array is [1, 2, 3, 7, 8, 10, 11]. The middle element is 7.  */

import java.util.Scanner;

public class q12medianoftwoarrays {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        int[] a = new int[n];
        int[] b = new int[m];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        for (int i = 0; i < m; i++) {
            b[i] = sc.nextInt();
        }

        int[] c = new int[n + m];

        int i = 0, j = 0, k = 0;

        while (i < n && j < m) {
            if (a[i] <= b[j]) {
                c[k] = a[i];
                i++;
            } else {
                c[k] = b[j];
                j++;
            }
            k++;
        }

        while (i < n) {
            c[k] = a[i];
            i++;
            k++;
        }

        while (j < m) {
            c[k] = b[j];
            j++;
            k++;
        }

        int total = n + m;
        double median;

        if (total % 2 == 1) {
            median = c[total / 2];
        } else {
            median = ((long) c[total / 2 - 1]
                    + c[total / 2]) / 2.0;
        }

        System.out.printf("%.1f%n", median);
    }
}

