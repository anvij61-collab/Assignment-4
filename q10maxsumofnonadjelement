/*Sample Input 6 
5 5 10 100 10 5 
Sample Output 110 
Explanation: Selecting 5 at index 0, 100 at index 3, and 5 at index 5 gives 110. Alterna vely, selecting 10 at index 2 and 100 at index 3 is not allowed because they are adjacent. The opmal valid selec on is 5 + 100 + 5 = 110. */

import java.util.Scanner;

public class q10maxsumofnonadjelement {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int prev2 = 0;
        int prev1 = 0;

        for (int i = 0; i < n; i++) {
            int pick = arr[i] + prev2;
            int notPick = prev1;

            int current = Math.max(pick, notPick);

            prev2 = prev1;
            prev1 = current;
        }

        System.out.println(prev1);
        sc.close();
    }
}

