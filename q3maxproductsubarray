import java.util.*;
public class q3maxproductsubarray {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter size");
        int size = sc.nextInt();

        int[] arr = new int[size];
        System.out.print("Enter element");
        for(int i=0; i<arr.length ;i++){
            arr[i] = sc.nextInt();
        }

        int maxProduct = arr[0], minending= arr[0] , maxending = arr[0];
        for(int j=1; j<size; j++){

            if (arr[j]<0){
                int temp = maxending;
            maxending = minending;
            minending = temp;
            }
            maxending = Math.max(arr[j], maxending* arr[j]);
        minending = Math.min(arr[j], minending* arr[j]);
        maxProduct = Math.max(maxending, minending);

        }
        System.out.println(maxProduct);
        
    }
}
