/*Sample Input 6 
2 1 5 6 2 3  
Sample Output 10  
Explanation: The bars of heights 5 and 6 form a rectangle of height 5 and width 2, giving area 10. 
 */

import java.util.*;

public class q19largestrectangleinhistogram {

    public static int largestRectangleArea(int[] heights) {

        int ns[] = findnextSmaller(heights);
        int ps[] = findprevSmaller(heights);

        int max = 0;

        for (int i = 0; i < heights.length; i++) {

            int h = heights[i];
            int w = ns[i] - ps[i] - 1;

            max = Math.max(max, h * w);
        }

        return max;
    }

    public static int[] findnextSmaller(int arr[]) {

        int n = arr.length;
        Stack<Integer> stack = new Stack<>();
        int res[] = new int[n];

        for (int i = n - 1; i >= 0; i--) {

            while (!stack.isEmpty() &&
                   arr[stack.peek()] >= arr[i]) {
                stack.pop();
            }

            if (stack.isEmpty()) {
                res[i] = n;
            } else {
                res[i] = stack.peek();
            }

            stack.push(i);
        }

        return res;
    }

    public static int[] findprevSmaller(int arr[]) {

        int n = arr.length;
        Stack<Integer> stack = new Stack<>();
        int res[] = new int[n];

        for (int i = 0; i < n; i++) {

            while (!stack.isEmpty() &&
                   arr[stack.peek()] >= arr[i]) {
                stack.pop();
            }

            if (stack.isEmpty()) {
                res[i] = -1;
            } else {
                res[i] = stack.peek();
            }

            stack.push(i);
        }

        return res;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int heights[] = new int[n];

        for (int i = 0; i < n; i++) {
            heights[i] = sc.nextInt();
        }

        System.out.println(largestRectangleArea(heights));

        sc.close();
    }
}

